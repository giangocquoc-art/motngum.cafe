# Chim Se AI runs only in the Vercel API function; these values are never exposed to the browser.
PSHAREHUB_API_BASE_URL=https://api.psharehub.com/v1
PSHAREHUB_API_KEY=
PSHAREHUB_API_KEYS=
# Model IDs are tried in this order; the backend rotates across model/key pairs.
PSHAREHUB_MODEL_IDS=nast/deepseek-ai/DeepSeek-V4.1-Flash,gemma-26b-a4b-it,glm-5.3-flash,tdug/nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
PSHAREHUB_REQUEST_TIMEOUT_MS=1800

# Optional outage alert. Send is suppressed until all AI key/model pairs have failed.
CLOUDFLARE_ACCOUNT_ID=3fb472351c1ce2a2d64188bbd484db3e
CLOUDFLARE_EMAIL_API_TOKEN=
CLOUDFLARE_ALERT_FROM=chimse-alert@motngum.cafe
