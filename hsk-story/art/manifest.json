      "cream paper",
      "muted orange",
      "pale sky blue",
      "faded teal",
      "dusty sage",
      "warm tan",
      "ink brown"
    ],
    "principles": [
      "everyday Chengdu details",
      "expressive imperfect characters",
      "clear readable silhouettes",
      "learning text remains HTML",
      "transparent sprite layers"
    ]
