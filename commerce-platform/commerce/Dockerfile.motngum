# Source at pinned official Medusa DTC starter, built as self-hosted API runtime.
FROM node:22.23.4-bookworm-slim
ENV NODE_ENV=production
ENV MEDUSA_DISABLE_TELEMETRY=true
WORKDIR /srv/commerce
RUN corepack enable && corepack prepare pnpm@10.11.1 --activate
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @dtc/backend build
WORKDIR /srv/commerce/apps/backend
EXPOSE 9000
CMD ["pnpm", "start"]
